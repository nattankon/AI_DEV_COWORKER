{
  "name": "ai-dev-coworker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "build": "vite build --config vite.config.js",
    "preview": "vite preview --config vite.config.js",
    "test": "vitest run --config vite.config.js",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "release": "npm run build && electron-builder --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.16.0",
    "pyodide": "^314.0.2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react-swc": "^4.3.1",
    "autoprefixer": "^10.5.0",
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.17",
    "vite": "^8.0.14",
    "vitest": "^4.1.8"
  },
  "build": {
    "appId": "local.ai.dev.coworker",
    "productName": "AI Dev Co-worker",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "tools/pyodide_runner.mjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".",
        "to": "cowork-sidecar/AI_DEV_COWORKER",
        "filter": [
          "*.py",
          "tools/pyodide_runner.mjs",
          "node_modules/pyodide/**",
          "!__pycache__/**",
          "!work_logs/**"
        ]
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "nattankon",
        "repo": "AI_DEV_COWORKER"
      }
    ]
  }
}
